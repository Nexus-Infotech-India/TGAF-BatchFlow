generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id        String   @id
  userId    String
  batchId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  Batch     Batch?   @relation(fields: [batchId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Batch {
  id                         String                @id
  batchNumber                String                @unique
  batchCode                  String?
  productId                  String
  grnNumber                  String?
  lotNumber                  String?
  dateOfProduction           DateTime
  bestBeforeDate             DateTime
  sampleAnalysisStarted      DateTime?
  sampleAnalysisCompleted    DateTime?
  sampleAnalysisStatus       SampleAnalysisStatus  @default(PENDING)
  makerId                    String
  checkerId                  String?
  status                     BatchStatus           @default(DRAFT)
  rejectionRemarks           String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime
  ActivityLog                ActivityLog[]
  User_Batch_checkerIdToUser User?                 @relation("Batch_checkerIdToUser", fields: [checkerId], references: [id])
  User_Batch_makerIdToUser   User                  @relation("Batch_makerIdToUser", fields: [makerId], references: [id])
  Product                    Product               @relation(fields: [productId], references: [id])
  parameterValues            BatchParameterValue[]
  Notification               Notification[]
  seedWastageRecords         SeedWastageRecord[]
  methodologies              Methodology[]         @relation("BatchToMethodology")
  standards                  Standard[]            @relation("BatchToStandard")
  unitOfMeasurements         UnitOfMeasurement[]   @relation("BatchToUnitOfMeasurement")
}

model ExportLog {
  id         String   @id
  fileName   String
  exportType String
  exportedBy String
  exportedAt DateTime @default(now())
}

model Methodology {
  id                   String                @id
  name                 String                @unique
  description          String
  procedure            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  batchParameterValues BatchParameterValue[]
  standardDefinitions  StandardDefinition[]
  batches              Batch[]               @relation("BatchToMethodology")
  Standards            Standard[]            @relation("StandardMethodologies")
}

model Notification {
  id        String           @id
  userId    String
  batchId   String?
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  Batch     Batch?           @relation(fields: [batchId], references: [id])
  User      User             @relation(fields: [userId], references: [id])
}

model Permission {
  id        String   @id
  action    String
  resource  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Role      Role[]   @relation("PermissionToRole")

  @@unique([action, resource])
}

model Product {
  id                 String                    @id
  name               String                    @unique
  code               String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime
  Batch              Batch[]
  parameters         ProductParameter[]
  standardCategories ProductStandardCategory[]
}

model ProductParameter {
  id          String            @id @default(uuid())
  productId   String
  parameterId String
  isRequired  Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parameter   StandardParameter @relation(fields: [parameterId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])

  @@unique([productId, parameterId])
}

model Role {
  id          String       @id
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  User        User[]
  Permission  Permission[] @relation("PermissionToRole")
}

model UnitOfMeasurement {
  id                   String                @id
  name                 String                @unique
  symbol               String
  description          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  batchParameterValues BatchParameterValue[]
  standardDefinitions  StandardDefinition[]
  standardParameters   StandardParameter[]
  batches              Batch[]               @relation("BatchToUnitOfMeasurement")
  Standards            Standard[]            @relation("StandardUnits")
}

model User {
  id                           String                  @id
  email                        String                  @unique
  name                         String
  password                     String
  roleId                       String
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime
  ActivityLog                  ActivityLog[]
  auditeeAudits                Audit[]                 @relation("AuditeeAudits")
  createdAudits                Audit[]                 @relation("CreatedAudits")
  uploadedAuditDocuments       AuditDocument[]
  inspectedItems               AuditInspectionItem[]   @relation("InspectedItems")
  auditNotifications           AuditNotification[]     @relation("AuditNotifications")
  createdReminders             AuditReminder[]         @relation("CreatedReminders")
  receivedReminders            AuditReminder[]         @relation("ReceivedReminders")
  auditorProfile               Auditor?                @relation("UserAuditor")
  Batch_Batch_checkerIdToUser  Batch[]                 @relation("Batch_checkerIdToUser")
  Batch_Batch_makerIdToUser    Batch[]                 @relation("Batch_makerIdToUser")
  BatchDrafts                  BatchDraft[]            @relation("BatchDraftMaker")
  assignedActions              CorrectiveAction[]      @relation("AssignedActions")
  verifiedActions              CorrectiveAction[]      @relation("VerifiedActions")
  uploadedFeedbackForms        FeedbackForm[]
  assignedFindings             Finding[]               @relation("AssignedFindings")
  Notification                 Notification[]
  createdChecklistItems        PreAuditChecklistItem[] @relation("CreatedChecklistItems")
  responsibleForChecklistItems PreAuditChecklistItem[] @relation("ResponsibleForChecklistItems")
  rmQualityReports             RMQualityReport[]
  fgQualityReports             FGQualityReport[]
  createdGRNs                  GRNbyPo[]               @relation("GRNCreatedBy")
  StandardsCreated             Standard[]              @relation("StandardCreatedBy")
  StandardsModified            Standard[]              @relation("StandardModifiedBy")
  standardDefinitionsCreated   StandardDefinition[]    @relation("StandardDefinitionsCreated")
  standardDefinitionsModified  StandardDefinition[]    @relation("StandardDefinitionsModified")
  createdTrainings             Training[]              @relation("CreatedTrainings")
  trainerTrainings             Training[]              @relation("TrainerTrainings")
  uploadedDocuments            TrainingDocument[]
  assignedFollowups            TrainingFollowup[]      @relation("AssignedFollowups")
  createdFollowups             TrainingFollowup[]      @relation("CreatedFollowups")
  trainingNotifications        TrainingNotification[]
  uploadedPhotos               TrainingPhoto[]
  uploadedSessionPhotos        TrainingSessionPhoto[]  @relation("UploadedSessionPhotos")
  transactionLogs              TransactionLog[]
  Role                         Role                    @relation(fields: [roleId], references: [id])
}

model BatchDraft {
  id                      String                @id @default(uuid())
  batchNumber             String?               @unique
  batchCode               String?
  productId               String?
  grnNumber               String?
  lotNumber               String?
  seedWastageQty          Float?
  dateOfProduction        DateTime?
  bestBeforeDate          DateTime?
  sampleAnalysisStarted   DateTime?
  sampleAnalysisCompleted DateTime?
  sampleAnalysisStatus    SampleAnalysisStatus? @default(PENDING)
  makerId                 String
  status                  BatchStatus           @default(DRAFT)
  newProductName          String?
  parameterValues         Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  maker                   User                  @relation("BatchDraftMaker", fields: [makerId], references: [id])
}

model Standard {
  id            String              @id
  name          String              @unique
  code          String              @unique
  description   String
  categoryId    String
  createdById   String
  modifiedById  String?
  status        StandardStatus      @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Category      StandardCategory    @relation(fields: [categoryId], references: [id])
  CreatedBy     User                @relation("StandardCreatedBy", fields: [createdById], references: [id])
  ModifiedBy    User?               @relation("StandardModifiedBy", fields: [modifiedById], references: [id])
  batches       Batch[]             @relation("BatchToStandard")
  methodologies Methodology[]       @relation("StandardMethodologies")
  units         UnitOfMeasurement[] @relation("StandardUnits")
}

model StandardCategory {
  id          String                    @id
  name        String                    @unique
  description String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime
  products    ProductStandardCategory[]
  Standards   Standard[]
  parameters  StandardParameter[]
}

model ProductStandardCategory {
  id         String           @id @default(uuid())
  productId  String
  categoryId String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  category   StandardCategory @relation(fields: [categoryId], references: [id])
  product    Product          @relation(fields: [productId], references: [id])

  @@unique([productId, categoryId])
}

model StandardParameter {
  id            String                @id
  name          String
  categoryId    String
  unitId        String?
  productType   String?
  description   String?
  dataType      ParameterDataType
  standardValue String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime
  batchValues   BatchParameterValue[]
  products      ProductParameter[]
  standards     StandardDefinition[]
  category      StandardCategory      @relation(fields: [categoryId], references: [id])
  unit          UnitOfMeasurement?    @relation(fields: [unitId], references: [id])

  @@unique([name, categoryId, productType])
}

model StandardDefinition {
  id            String             @id
  parameterId   String
  standardValue String
  unitId        String?
  methodologyId String?
  createdById   String
  modifiedById  String?
  status        StandardStatus     @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime
  CreatedBy     User               @relation("StandardDefinitionsCreated", fields: [createdById], references: [id])
  methodology   Methodology?       @relation(fields: [methodologyId], references: [id])
  ModifiedBy    User?              @relation("StandardDefinitionsModified", fields: [modifiedById], references: [id])
  parameter     StandardParameter  @relation(fields: [parameterId], references: [id])
  unit          UnitOfMeasurement? @relation(fields: [unitId], references: [id])
}

model BatchParameterValue {
  id                 String             @id
  batchId            String
  parameterId        String
  value              String
  standardValue      String?
  remark             String?
  unitId             String?
  methodologyId      String?
  verificationResult String?
  verificationRemark String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  batch              Batch              @relation(fields: [batchId], references: [id])
  methodology        Methodology?       @relation(fields: [methodologyId], references: [id])
  parameter          StandardParameter  @relation(fields: [parameterId], references: [id])
  unit               UnitOfMeasurement? @relation(fields: [unitId], references: [id])

  @@unique([batchId, parameterId])
}

model TrainingCalendar {
  id          String     @id @default(uuid())
  month       Int
  year        Int
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  trainings   Training[]

  @@unique([month, year])
}

model Training {
  id              String                 @id @default(uuid())
  title           String
  description     String?
  trainingType    TrainingType
  status          TrainingStatus         @default(SCHEDULED)
  startDate       DateTime
  endDate         DateTime
  location        String
  maxParticipants Int?
  trainerId       String
  calendarId      String
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  attendance      Attendance[]
  feedbackForms   FeedbackForm[]
  calendar        TrainingCalendar       @relation(fields: [calendarId], references: [id])
  createdBy       User                   @relation("CreatedTrainings", fields: [createdById], references: [id])
  trainer         User                   @relation("TrainerTrainings", fields: [trainerId], references: [id])
  documents       TrainingDocument[]
  feedback        TrainingFeedback[]
  followups       TrainingFollowup[]
  inviteTokens    TrainingInviteToken[]
  notifications   TrainingNotification[]
  participants    TrainingParticipant[]
  photos          TrainingPhoto[]
  sessions        TrainingSession[]
}

model TrainingSession {
  id            String                 @id @default(uuid())
  trainingId    String
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  venue         String
  status        TrainingStatus         @default(SCHEDULED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  attendance    Attendance[]
  feedbackForms FeedbackForm[]
  training      Training               @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  photos        TrainingSessionPhoto[]
}

model TrainingDocument {
  id           String       @id @default(uuid())
  trainingId   String
  sessionId    String?
  title        String
  description  String?
  fileUrl      String
  filePath     String?
  documentType DocumentType
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  training     Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
}

model Participant {
  id            String                @id @default(uuid())
  name          String
  email         String                @unique
  phone         String?
  organization  String?
  position      String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  attendances   Attendance[]
  feedbackForms FeedbackForm[]
  feedbacks     TrainingFeedback[]
  inviteTokens  TrainingInviteToken[]
  trainings     TrainingParticipant[]
}

model TrainingParticipant {
  id             String      @id @default(uuid())
  trainingId     String
  participantId  String
  inviteSent     Boolean     @default(false)
  inviteSentAt   DateTime?
  inviteAccepted Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  participant    Participant @relation(fields: [participantId], references: [id])
  training       Training    @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, participantId])
}

model Attendance {
  id            String           @id @default(uuid())
  trainingId    String
  sessionId     String
  participantId String
  status        AttendanceStatus
  remarks       String?
  signatureUrl  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  participant   Participant      @relation(fields: [participantId], references: [id])
  session       TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  training      Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
}

model TrainingPhoto {
  id           String   @id @default(uuid())
  trainingId   String
  photoUrl     String
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())
  training     Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model TrainingFeedback {
  id                    String      @id @default(uuid())
  trainingId            String
  participantId         String
  contentRating         Int
  trainerRating         Int
  materialRating        Int
  venueRating           Int
  overallRating         Int
  comments              String?
  suggestedImprovements String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  participant           Participant @relation(fields: [participantId], references: [id])
  training              Training    @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, participantId])
}

model FeedbackForm {
  id            String          @id @default(uuid())
  trainingId    String
  sessionId     String
  participantId String
  fileUrl       String
  filePath      String?
  submittedAt   DateTime        @default(now())
  uploadedById  String
  participant   Participant     @relation(fields: [participantId], references: [id])
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  training      Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  uploadedBy    User            @relation(fields: [uploadedById], references: [id])

  @@unique([sessionId, participantId])
}

model TrainingFollowup {
  id           String    @id @default(uuid())
  trainingId   String
  title        String
  description  String
  dueDate      DateTime?
  isCompleted  Boolean   @default(false)
  assignedToId String
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  assignedTo   User      @relation("AssignedFollowups", fields: [assignedToId], references: [id])
  createdBy    User      @relation("CreatedFollowups", fields: [createdById], references: [id])
  training     Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
}

model TrainingNotification {
  id         String    @id @default(uuid())
  trainingId String
  userId     String
  title      String
  message    String
  isRead     Boolean   @default(false)
  sentAt     DateTime  @default(now())
  readAt     DateTime?
  training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])
}

model TrainingInviteToken {
  id            String       @id @default(uuid())
  token         String       @unique
  action        String
  trainingId    String
  participantId String?
  email         String
  expiresAt     DateTime
  used          Boolean      @default(false)
  createdAt     DateTime     @default(now())
  participant   Participant? @relation(fields: [participantId], references: [id])
  training      Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([token])
}

model TrainingSessionPhoto {
  id           String          @id @default(uuid())
  sessionId    String
  photoUrl     String
  caption      String?
  uploadedById String
  createdAt    DateTime        @default(now())
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("UploadedSessionPhotos", fields: [uploadedById], references: [id])
}

model Auditor {
  id         String   @id @default(uuid())
  name       String
  email      String
  userId     String?  @unique
  isExternal Boolean  @default(false)
  firmName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  audits     Audit[]
  user       User?    @relation("UserAuditor", fields: [userId], references: [id])
}

model Audit {
  id              String                  @id @default(uuid())
  name            String
  auditType       AuditType
  status          AuditStatus             @default(PLANNED)
  startDate       DateTime
  endDate         DateTime?
  auditorId       String
  auditeeId       String?
  firmName        String?
  departmentId    String?
  objectives      String?
  scope           String?
  summary         String?
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  auditee         User?                   @relation("AuditeeAudits", fields: [auditeeId], references: [id])
  auditor         Auditor                 @relation(fields: [auditorId], references: [id])
  createdBy       User                    @relation("CreatedAudits", fields: [createdById], references: [id])
  department      Department?             @relation(fields: [departmentId], references: [id])
  documents       AuditDocument[]
  inspectionItems AuditInspectionItem[]
  notifications   AuditNotification[]
  reminders       AuditReminder[]
  actions         CorrectiveAction[]
  findings        Finding[]
  checklistItems  PreAuditChecklistItem[]
}

model AuditInspectionItem {
  id                String   @id @default(uuid())
  auditId           String
  areaName          String
  itemName          String
  description       String?
  standardReference String?
  isCompliant       Boolean?
  comments          String?
  evidence          String?
  inspectedById     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  audit             Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  inspectedBy       User?    @relation("InspectedItems", fields: [inspectedById], references: [id])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  audits      Audit[]
}

model Finding {
  id           String             @id @default(uuid())
  auditId      String
  title        String
  description  String
  findingType  FindingType
  status       FindingStatus      @default(OPEN)
  priority     Priority?          @default(MEDIUM)
  dueDate      DateTime?
  assignedToId String?
  evidence     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  closedAt     DateTime?
  actions      CorrectiveAction[]
  assignedTo   User?              @relation("AssignedFindings", fields: [assignedToId], references: [id])
  audit        Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model CorrectiveAction {
  id           String    @id @default(uuid())
  auditId      String
  findingId    String?
  title        String
  description  String
  actionType   String
  assignedToId String
  dueDate      DateTime
  status       String
  completedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?
  evidence     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User      @relation("AssignedActions", fields: [assignedToId], references: [id])
  audit        Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding      Finding?  @relation(fields: [findingId], references: [id])
  verifiedBy   User?     @relation("VerifiedActions", fields: [verifiedById], references: [id])
}

model AuditDocument {
  id           String            @id @default(uuid())
  auditId      String
  title        String
  description  String?
  documentType AuditDocumentType
  fileUrl      String
  filePath     String?
  uploadedById String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  audit        Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
}

model PreAuditChecklistItem {
  id            String    @id @default(uuid())
  auditId       String
  description   String
  isCompleted   Boolean   @default(false)
  comments      String?
  responsibleId String
  dueDate       DateTime?
  completedAt   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  audit         Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("CreatedChecklistItems", fields: [createdById], references: [id])
  responsible   User      @relation("ResponsibleForChecklistItems", fields: [responsibleId], references: [id])
}

model AuditReminder {
  id          String    @id @default(uuid())
  auditId     String
  title       String
  message     String
  dueDate     DateTime
  status      String
  recipientId String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  audit       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("CreatedReminders", fields: [createdById], references: [id])
  recipient   User      @relation("ReceivedReminders", fields: [recipientId], references: [id])
}

model AuditNotification {
  id      String    @id @default(uuid())
  auditId String
  userId  String
  title   String
  message String
  isRead  Boolean   @default(false)
  sentAt  DateTime  @default(now())
  readAt  DateTime?
  audit   Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user    User      @relation("AuditNotifications", fields: [userId], references: [id])
}

model Vendor {
  id             String               @id @default(uuid())
  vendorCode     String               @unique
  name           String
  address        String
  contactPerson  String
  contactNumber  String
  email          String
  bankName       String?
  accountHolder  String?
  accountNo      String?
  enabled        Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  purchaseOrders PurchaseOrder[]
  rawMaterials   RawMaterialProduct[]
}

model RawMaterialProduct {
  id                 String              @id @default(uuid())
  skuCode            String              @unique
  name               String
  category           MaterialCategory
  subcategory        String?
  variety            String?
  unitOfMeasurement  String
  minReorderLevel    Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  vendorId           String?
  cleaningJobs       CleaningJob[]
  cleaningLots       CleaningLot[]
  currentStocks      CurrentStock[]
  processingJobs     ProcessingJob[]
  purchaseOrderItems PurchaseOrderItem[]
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  stockEntries       StockEntry[]
  bomItems           BOMItem[]
  bomsAsSfg          BillOfMaterial[]    @relation("BOMSfgProduct")
  grindingDispatches GrindingDispatch[]
  fgPackagingMaster  FGPackagingMaster?
}

model FGPackagingMaster {
  id             String   @id @default(uuid())
  rawMaterialId  String   @unique
  packetSize     Float
  packetUnit     String
  cartonCapacity Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rawMaterial RawMaterialProduct @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  vendorId     String
  orderDate    DateTime
  expectedDate DateTime
  status       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  items        PurchaseOrderItem[]
  grns         GRNbyPo[]
}

model PurchaseOrderItem {
  id              String                  @id @default(uuid())
  purchaseOrderId String
  rawMaterialId   String
  quantityOrdered Float
  quantityUnit    String                  @default("KG")
  rate            Float
  totalReceived   Float                   @default(0)
  status          PurchaseOrderItemStatus @default(PENDING)
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  rawMaterial     RawMaterialProduct      @relation(fields: [rawMaterialId], references: [id])
  receivals       ReceivalEntry[]
  grns            GRNbyPo[]
}

model ReceivalEntry {
  id                  String            @id @default(uuid())
  purchaseOrderItemId String
  locationId          String?
  warehouseId         String?
  weightMode          WeightMode        @default(INDIVIDUAL)
  totalWeight         Float
  notes               String?
  receivedDate        DateTime          @default(now())
  bags                ReceivalBag[]
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  location            Location?         @relation(fields: [locationId], references: [id])
  warehouse           Warehouse?        @relation(fields: [warehouseId], references: [id])
}

model ReceivalBag {
  id              String        @id @default(uuid())
  receivalEntryId String
  bagNo           Int
  bagWeight       Float
  receivalEntry   ReceivalEntry @relation(fields: [receivalEntryId], references: [id], onDelete: Cascade)
}

model StockEntry {
  id            String             @id @default(uuid())
  rawMaterialId String
  warehouseId   String
  batchNumber   String?
  expiryDate    DateTime?
  quantity      Float
  entryType     String
  referenceId   String?
  status        String
  reasonCode    String?
  createdAt     DateTime           @default(now())
  rawMaterial   RawMaterialProduct @relation(fields: [rawMaterialId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
}

model Warehouse {
  id               String            @id @default(uuid())
  name             String
  location         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  byProducts       ByProduct[]
  cleaningJobsFrom CleaningJob[]     @relation("CleaningFromWarehouse")
  cleaningJobsTo   CleaningJob[]     @relation("CleaningToWarehouse")
  cleaningLogsFrom CleaningLog[]     @relation("CleaningFromWarehouse")
  cleaningLogsTo   CleaningLog[]     @relation("CleaningToWarehouse")
  cleaningLots     CleaningLot[]
  currentStocks    CurrentStock[]
  finishedGoods    FinishedGood[]
  receivalEntries  ReceivalEntry[]
  reusableStocks   ReusableStock[]
  stockEntries     StockEntry[]
  unfinishedStocks UnfinishedStock[]
  processingJobs   ProcessingJob[]
}

// ==================== LOCATION MASTER ====================

enum LocationType {
  WAREHOUSE
  CLEANING
  GRINDING
  SFG_WAREHOUSE
  OTHER
}

model Location {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        LocationType
  address     String?
  description String?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  receivalEntries ReceivalEntry[]
  transfersFrom   MaterialTransfer[] @relation("TransferFromLocation")
  transfersTo     MaterialTransfer[] @relation("TransferToLocation")
  dispatchesFrom  GrindingDispatch[] @relation("DispatchFromLocation")
  dispatchesTo    GrindingDispatch[] @relation("DispatchToLocation")
}

// ==================== MATERIAL TRANSFER ====================

enum TransferStatus {
  SENT
  ACCEPTED
  REJECTED
}

enum TransferDirection {
  INBOUND_TO_GRINDING
  OUTBOUND_FROM_GRINDING
  SFG_TO_PRODUCTION
}

enum TransferLineType {
  RAW_MATERIAL
  SFG
  BYPRODUCT
  SCRAP
}

model MaterialTransfer {
  id              String            @id @default(uuid())
  transferNumber  String            @unique
  direction       TransferDirection
  fromLocationId  String
  toLocationId    String
  status          TransferStatus    @default(SENT)
  sentById        String
  sentAt          DateTime          @default(now())
  acceptedById    String?
  acceptedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  fromLocation Location               @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location               @relation("TransferToLocation", fields: [toLocationId], references: [id])
  lines        MaterialTransferLine[]
}

model MaterialTransferLine {
  id                String           @id @default(uuid())
  transferId        String
  lineType          TransferLineType
  rawMaterialId     String?
  productName       String?
  skuCode           String?
  quantity          Float
  unitOfMeasurement String
  batchNumber       String?
  cleaningLotId     String?
  numberOfBags      Int?
  bagSizeKg         Float?           @default(25)
  totalPackedQty    Float?
  totalPackedUnit   String?
  createdAt         DateTime         @default(now())

  transfer MaterialTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

// ==================== PRODUCTION POSTING ====================

enum OutputType {
  SFG
  BYPRODUCT
  SCRAP
}

model ProductionPosting {
  id             String   @id @default(uuid())
  postingNumber  String   @unique
  sfgProductId   String
  bomId          String
  locationId     String
  shiftDate      DateTime
  productionQty  Float?
  productionUnit String?
  status         String   @default("POSTED")
  notes          String?
  postedById     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consumptions ProductionConsumption[]
  outputs      ProductionOutput[]
}

model ProductionConsumption {
  id               String   @id @default(uuid())
  postingId        String
  rawMaterialId    String
  rawMaterialName  String?
  expectedQuantity Float
  actualQuantity   Float
  unit             String?
  sourceType       String? // 'BATCH' or 'STOCK'
  batchNumber      String?
  dispatchId       String? // Reference to GrindingDispatch used
  cleaningLotId    String?
  createdAt        DateTime @default(now())

  posting ProductionPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
}

model ProductionOutput {
  id          String     @id @default(uuid())
  postingId   String
  outputType  OutputType
  productName String
  skuCode     String?
  quantity    Float
  unit        String
  batchNumber String?
  createdAt   DateTime   @default(now())

  posting ProductionPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
}

model CleaningJob {
  id                  String             @id
  rawMaterialId       String
  fromWarehouseId     String
  toWarehouseId       String
  quantity            Float
  status              String
  startedAt           DateTime
  finishedAt          DateTime?
  grnId               String?
  stoneWastageQty     Float?             @default(0)
  stoneWastageUnit    String?            @default("kg")
  seedWastageQty      Float?             @default(0)
  seedWastageUnit     String?            @default("kg")
  cleanedQuantity     Float?             @default(0)
  cleanedQuantityUnit String?            @default("kg")
  wastagePercentage   Float?             @default(0)
  wastageType         String?
  fromWarehouse       Warehouse          @relation("CleaningFromWarehouse", fields: [fromWarehouseId], references: [id])
  rawMaterial         RawMaterialProduct @relation(fields: [rawMaterialId], references: [id])
  toWarehouse         Warehouse          @relation("CleaningToWarehouse", fields: [toWarehouseId], references: [id])
  grn                 GRNbyPo?           @relation(fields: [grnId], references: [id])
  cleaningLogs        CleaningLog[]
  cleaningLots        CleaningLot[]
}

model CleaningLog {
  id              String      @id @default(uuid())
  cleaningJobId   String
  from            String
  to              String
  dateTime        DateTime
  quantity        Float
  status          String
  fromWarehouseId String
  toWarehouseId   String
  cleaningJob     CleaningJob @relation(fields: [cleaningJobId], references: [id])
  fromWarehouse   Warehouse   @relation("CleaningFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse   @relation("CleaningToWarehouse", fields: [toWarehouseId], references: [id])
}

model UnfinishedStock {
  id              String    @id @default(uuid())
  cleaningJobId   String?
  processingJobId String?
  skuCode         String
  quantity        Float
  reasonCode      String
  warehouseId     String
  createdAt       DateTime  @default(now())
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
}

model ProcessingJob {
  id                  String               @id
  batchNumber         String?              @unique
  inputRawMaterialId  String
  warehouseId         String?
  quantityInput       Float
  startedAt           DateTime
  finishedAt          DateTime?
  status              String
  byProducts          ByProduct[]
  finishedGoods       FinishedGood[]
  processingBatchLots ProcessingBatchLot[]
  inputRawMaterial    RawMaterialProduct   @relation(fields: [inputRawMaterialId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id])
}

model FinishedGood {
  id                String         @id @default(uuid())
  skuCode           String         @unique
  name              String
  category          String
  unitOfMeasurement String
  quantity          Float
  warehouseId       String
  processingJobId   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  processingJob     ProcessingJob? @relation(fields: [processingJobId], references: [id])
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id])
}

model ByProduct {
  id              String        @id @default(uuid())
  processingJobId String
  skuCode         String
  quantity        Float
  warehouseId     String
  tag             String
  reason          String?
  createdAt       DateTime      @default(now())
  processingJob   ProcessingJob @relation(fields: [processingJobId], references: [id])
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
}

model CurrentStock {
  id              String             @id @default(uuid())
  rawMaterialId   String
  warehouseId     String
  currentQuantity Float
  quantityUnit    String?
  lastUpdated     DateTime           @updatedAt
  rawMaterial     RawMaterialProduct @relation(fields: [rawMaterialId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])

  @@unique([rawMaterialId, warehouseId])
}

model TransactionLog {
  id          String   @id @default(uuid())
  type        String
  entity      String
  entityId    String
  userId      String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model ReusableStock {
  id              String    @id @default(uuid())
  cleaningJobId   String?
  processingJobId String?
  skuCode         String
  quantity        Float
  warehouseId     String
  createdAt       DateTime  @default(now())
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
}

model RMQualityReport {
  id                  String               @id @default(uuid())
  reportNumber        String?              @unique
  rawMaterialName     String
  variety             String
  supplier            String
  purchaseOrderId     String?
  purchaseOrderItemId String?
  dateOfReport        DateTime             @default(now())
  grn                 String?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  parameters          RMQualityParameter[]
  createdBy           User                 @relation(fields: [createdById], references: [id])
  grn_entry           GRNbyPo?
}

model RMQualityParameter {
  id        String          @id @default(uuid())
  reportId  String
  parameter String
  standard  String
  result    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  report    RMQualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

enum MaterialCategory {
  RAW_MATERIAL
  SEMI_FINISHED_GOOD
  FINISHED_GOOD
  PACKAGING_MATERIAL
  BYPRODUCT
  WASTAGE
}

enum BatchStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum NotificationType {
  BATCH_SUBMITTED
  BATCH_APPROVED
  BATCH_REJECTED
  SYSTEM
}

enum SampleAnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StandardStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum ParameterDataType {
  TEXT
  FLOAT
  INTEGER
  BOOLEAN
  PERCENTAGE
  DATE
}

enum TrainingType {
  TECHNICAL
  SAFETY
  COMPLIANCE
  ONBOARDING
  PROFESSIONAL_DEVELOPMENT
  WORKSHOP
  SEMINAR
}

enum TrainingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum DocumentType {
  COURSE_MATERIAL
  PRESENTATION
  AGENDA
  GUIDELINE
  CERTIFICATE
  ASSESSMENT
  FEEDBACK_FORM
  OTHER
}

enum ParticipantType {
  INTERNAL
  EXTERNAL
}

enum AuditType {
  INTERNAL
  EXTERNAL
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

enum FindingType {
  OBSERVATION
  NON_CONFORMITY
  MAJOR_NON_CONFORMITY
  OPPORTUNITY_FOR_IMPROVEMENT
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
}

enum AuditDocumentType {
  CHECKLIST
  PROCEDURE
  CERTIFICATE
  EVIDENCE
  REPORT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PurchaseOrderItemStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
}

enum WeightMode {
  INDIVIDUAL
  TOTAL
}

model GRNbyPo {
  id                  String   @id @default(uuid())
  grnNumber           String   @unique
  purchaseOrderId     String
  purchaseOrderItemId String
  rawMaterialName     String
  variety             String
  supplier            String
  qualityReportId     String?  @unique
  createdById         String
  truckNumber         String?
  deliveryLocation    String?
  costCenter          String?
  receivedBagsPacks   String?
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  qualityReport     RMQualityReport?  @relation(fields: [qualityReportId], references: [id])
  createdBy         User              @relation("GRNCreatedBy", fields: [createdById], references: [id])
  cleaningJobs      CleaningJob[]
  cleaningLots      CleaningLot[]
}

model CleaningLot {
  id                  String   @id @default(uuid())
  lotNumber           String   @unique
  cleaningJobId       String
  grnId               String
  rawMaterialId       String
  warehouseId         String
  quantity            Float
  cleanedQuantity     Float?   @default(0)
  cleanedQuantityUnit String?  @default("kg")
  status              String   @default("Active")
  stoneWastageQty     Float?   @default(0)
  stoneWastageUnit    String?  @default("kg")
  seedWastageQty      Float?   @default(0)
  seedWastageUnit     String?  @default("kg")
  wastagePercentage   Float?   @default(0)
  wastageType         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cleaningJob          CleaningJob           @relation(fields: [cleaningJobId], references: [id])
  grn                  GRNbyPo               @relation(fields: [grnId], references: [id])
  rawMaterial          RawMaterialProduct    @relation(fields: [rawMaterialId], references: [id])
  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id])
  processingBatchLots  ProcessingBatchLot[]
  grindingDispatchLots GrindingDispatchLot[]
}

model ProcessingBatchLot {
  id                   String   @id @default(uuid())
  processingJobId      String
  cleaningLotId        String
  allocatedQuantity    Float
  seedWastageAllocated Float    @default(0)
  createdAt            DateTime @default(now())

  processingJob ProcessingJob @relation(fields: [processingJobId], references: [id])
  cleaningLot   CleaningLot   @relation(fields: [cleaningLotId], references: [id])
}

// ==================== BILL OF MATERIAL ====================

enum BOMStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model BillOfMaterial {
  id                String              @id @default(uuid())
  bomCode           String              @unique
  productName       String
  productCode       String?
  sfgProductId      String?
  unitOfMeasurement String
  outputQuantity    Float               @default(1)
  description       String?
  status            BOMStatus           @default(DRAFT)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  items             BOMItem[]
  sfgProduct        RawMaterialProduct? @relation("BOMSfgProduct", fields: [sfgProductId], references: [id])
}

model BOMItem {
  id                String   @id @default(uuid())
  bomId             String
  rawMaterialId     String
  quantity          Float
  unitOfMeasurement String
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bom         BillOfMaterial     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterialProduct @relation(fields: [rawMaterialId], references: [id])

  @@unique([bomId, rawMaterialId])
}

// ==================== SEED WASTAGE TRACKING ====================

model SeedWastageRecord {
  id                String   @id @default(uuid())
  batchId           String?
  lotNumber         String
  grnNumber         String
  skuCode           String
  quantity          Float
  allocatedQuantity Float    @default(0)
  restWastage       Float    @default(0)
  unit              String   @default("kg")
  source            String   @default("batch") // "cleaning" or "batch"
  createdAt         DateTime @default(now())

  batch Batch? @relation(fields: [batchId], references: [id])
}

// ==================== GRINDING DISPATCH (Transfer with Approval) ====================

enum GrindingDispatchStatus {
  SENT
  ACCEPTED
  REJECTED
}

model GrindingDispatch {
  id                 String                 @id @default(uuid())
  batchNumber        String                 @unique
  inputRawMaterialId String
  fromLocationId     String
  toLocationId       String
  totalQuantity      Float
  consumedQuantity   Float                  @default(0)
  status             GrindingDispatchStatus @default(SENT)
  sentAt             DateTime               @default(now())
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  inputRawMaterial RawMaterialProduct    @relation(fields: [inputRawMaterialId], references: [id])
  fromLocation     Location              @relation("DispatchFromLocation", fields: [fromLocationId], references: [id])
  toLocation       Location              @relation("DispatchToLocation", fields: [toLocationId], references: [id])
  lots             GrindingDispatchLot[]
}

model GrindingDispatchLot {
  id                   String   @id @default(uuid())
  dispatchId           String
  cleaningLotId        String
  allocatedQuantity    Float
  seedWastageAllocated Float    @default(0)
  createdAt            DateTime @default(now())

  dispatch    GrindingDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  cleaningLot CleaningLot      @relation(fields: [cleaningLotId], references: [id])
}

// ==================== FG BATCH (Finished Good Batch) ====================

model FGBatch {
  id             String   @id @default(uuid())
  batchNumber    String   @unique
  bomId          String
  fgProductName  String
  productionQty  Float
  productionUnit String
  packetSize     Float?
  packetUnit     String?
  totalPackets   Int      @default(0)
  cartonCapacity Int?
  totalCartons   Int      @default(0)
  status         String   @default("CREATED")
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consumptions      FGBatchConsumption[]
  productionEntries FGProductionEntry[]
  fgQualityReports  FGQualityReport[]
}

model FGBatchConsumption {
  id               String   @id @default(uuid())
  fgBatchId        String
  rawMaterialId    String
  rawMaterialName  String?
  expectedQuantity Float
  actualQuantity   Float
  unit             String?
  sourceType       String? // 'SFG_BATCH' or 'STOCK'
  batchNumber      String?
  dispatchId       String?
  createdAt        DateTime @default(now())

  fgBatch FGBatch @relation(fields: [fgBatchId], references: [id], onDelete: Cascade)
}

// ==================== FG PRODUCTION ENTRY ====================

model FGProductionEntry {
  id                   String   @id @default(uuid())
  entryNumber          String   @unique
  fgBatchId            String
  bomId                String
  fgProductName        String
  targetQty            Float
  targetUnit           String
  packetSize           Float?
  packetUnit           String?
  cartonCapacity       Int?
  totalPlannedPackets  Int      @default(0)
  totalPlannedCartons  Int      @default(0)
  totalActualFg        Float    @default(0)
  totalActualByproduct Float    @default(0)
  totalActualScrap     Float    @default(0)
  totalActualPackets   Int      @default(0)
  totalActualCartons   Int      @default(0)
  status               String   @default("DRAFT")
  notes                String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  fgBatch        FGBatch                    @relation(fields: [fgBatchId], references: [id])
  machineEntries FGProductionMachineEntry[]
  verifications  FGProductionVerification[]
  qualityReport  FGQualityReport?
}

model FGProductionMachineEntry {
  id                        String   @id @default(uuid())
  productionEntryId         String
  machineId                 String
  machineName               String
  allocatedQty              Float    @default(0)
  allocatedUnit             String   @default("Ton")
  plannedPackets            Int      @default(0)
  plannedCartons            Int      @default(0)
  actualFgQty               Float    @default(0)
  actualFgUnit              String   @default("Ton")
  actualByproduct           Float    @default(0)
  actualByproductUnit       String   @default("Ton")
  actualScrap               Float    @default(0)
  actualScrapUnit           String   @default("Ton")
  actualPackets             Int      @default(0)
  actualCartons             Int      @default(0)
  machineSpeed              String?
  todayAchieve              Float?
  laminateConsumption       Float?
  sfgConsumption            Float?
  laminateWastageKg         Float?
  laminateWastagePercentage Float?
  noManPower                Boolean  @default(false)
  notes                     String?
  createdAt                 DateTime @default(now())

  productionEntry FGProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  machine         Machine           @relation(fields: [machineId], references: [id])
}

// ==================== MACHINE MASTER ====================

model Machine {
  id           String   @id @default(uuid())
  machineId    String   @unique
  name         String
  location     String
  capacityQty  Float
  capacityUnit String   @default("KG_PER_SHIFT")
  machineSpeed String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productionMachineEntries FGProductionMachineEntry[]
}

// ==================== FG PRODUCTION VERIFICATION ====================

model FGProductionVerification {
  id                 String    @id @default(uuid())
  verificationNumber String    @unique
  productionEntryId  String
  entryNumber        String
  fgProductName      String
  totalPackets       Int       @default(0)
  totalCartons       Int       @default(0)
  packetSize         Float?
  packetUnit         String?
  cartonCapacity     Int?
  toLocationId       String
  toLocationName     String?
  status             String    @default("PENDING") // PENDING, ACCEPTED, REJECTED
  rejectionReason    String?
  notes              String?
  dispatchedById     String?
  dispatchedAt       DateTime  @default(now())
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  productionEntry FGProductionEntry @relation(fields: [productionEntryId], references: [id])
}

model FGQualityReport {
  id                String   @id @default(uuid())
  reportNumber      String?  @unique
  fgBatchId         String?
  productionEntryId String   @unique
  productName       String
  dateOfReport      DateTime @default(now())
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parameters      FGQualityParameter[]
  productionEntry FGProductionEntry    @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  fgBatch         FGBatch?             @relation(fields: [fgBatchId], references: [id])
  createdBy       User                 @relation(fields: [createdById], references: [id])
}

model FGQualityParameter {
  id        String   @id @default(uuid())
  reportId  String
  parameter String
  standard  String
  result    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report FGQualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
